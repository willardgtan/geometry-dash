  "phases": [
    {
      "phase": 0,
      "name": "Reactive",
      "description": "Single cube jumps over spikes and blocks on flat ground",
      "goal": "Learn jump/no-jump decision with >=95% accuracy",
      "mechanics": ["spikes", "blocks", "flat_ground"]
    },
    {
      "phase": 1,
      "name": "Ballistic",
      "description": "Jump timing and landing position control",
      "goal": "Complete short cube sections with >=90% success",
      "mechanics": ["jump_timing", "velocity_control", "landing"]
    },
    {
      "phase": 2,
      "name": "Local Geometry",
      "description": "Navigate blocks, spikes, and gaps; reason about nearby obstacles",
      "goal": "Complete sections with 3-5 obstacles in sequence at >=85% success",
      "mechanics": ["obstacle_sequences", "gap_jumping", "local_planning"]
    },
    {
      "phase": 3,
      "name": "State-Dependent",
      "description": "Use orbs and pads; handle fresh-click vs held input; learn gravity sensitivity",
      "goal": "Complete orb/pad sections with >=80% success",
      "mechanics": ["orb", "pad", "gravity_sensitivity", "input_mode"]
    },
    {
      "phase": 4,
      "name": "Mode Transition",
      "description": "Navigate portals (gravity inversion, speed changes, mode switches)",
      "goal": "Complete portal sections with >=75% success on first mode transition",
      "mechanics": ["portal", "gravity_inversion", "speed_portal", "mode_change"]
    },
    {
      "phase": 5,
      "name": "Continuous Control",
      "description": "Master ship, wave, robot modes (different control schemes)",
      "goal": "Complete ship/wave/robot sections with >=75% success",
      "mechanics": ["ship", "wave", "robot", "continuous_input"]
    },
    {
      "phase": 6,
      "name": "Long Horizon",
      "description": "Plan across obstacle sequences requiring early setup (20+ seconds)",
      "goal": "Complete full levels or long sections with >=70% success",
      "mechanics": ["planning", "long_sequences", "recovery"]
    },
    {
      "phase": 7,
      "name": "Generalization",
      "description": "Unseen level sections, random physics perturbations",
      "goal": "Complete unseen content with >=60% success on first attempt",
      "mechanics": ["generalization", "robustness", "adaptation"]
    }
  ]
}
